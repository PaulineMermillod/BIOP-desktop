ARG BASE_IMAGE=0.1.0
FROM biop/biop-vnc-base:${BASE_IMAGE}
ARG BASE_IMAGE=0.1.0 
ARG ALIAS=biop/
ARG FIJI_VERSION=20250317
FROM ${ALIAS}biop-fiji:${FIJI_VERSION} AS fiji-image
FROM ${ALIAS}biop-vnc-base:${BASE_IMAGE}

USER root

#install VS code
RUN apt-get update -y \
    && apt upgrade -y \
    # download vscode deb package
    && wget https://go.microsoft.com/fwlink/?LinkID=760868 -O /tmp/code.deb \
    # install vscode
    && apt install -y /tmp/code.deb \
    && rm /tmp/code.deb \
    && apt-get autoremove --purge \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/* \
    && rm -rf /tmp/* \
    && find /var/log -type f -exec cp /dev/null \{\} \;

#make an environment
COPY gan4mic/env_gan4mic.yml /tmp/env_gan4mic.yml
RUN conda env update -n gan4mic -f /tmp/env_gan4mic.yml \
    && conda clean --all -f -y \
    && conda env export -n "biop" \ 
    && rm /tmp/env_gan4mic.yml 

    
# Install Fiji
COPY --from=fiji-image /opt/Fiji.app /opt/Fiji.app
COPY --from=fiji-image /home/biop/Desktop/Fiji.desktop /home/biop/Desktop/Fiji.desktop
RUN chmod -R a+rwX /opt/Fiji.app/ImageJ-linux64
RUN chmod -R a+rwX /home/biop/ \
&& chown -R biop:biop /home/biop/


#################################################################
# Container start
USER biop
WORKDIR /home/biop
ENTRYPOINT ["/usr/local/bin/jupyter"]
CMD ["lab", "--allow-root", "--ip=*", "--port=8888", "--no-browser", "--NotebookApp.token=''", "--NotebookApp.allow_origin='*'", "--notebook-dir=/home/biop"]
